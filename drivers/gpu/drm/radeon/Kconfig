config DRM_RADEON
	tristate "ATI Radeon"
	depends on DRM && PCI && MMU
	depends on AGP || !AGP
	select DRM_DISPLAY_DP_HELPER
	select DRM_DISPLAY_HELPER
        select DRM_KMS_HELPER
	select DRM_SUBALLOC_HELPER
        select DRM_TTM
	select DRM_TTM_HELPER
	select I2C_ALGOBIT
	# 注（Task#202）：同 amdgpu，移除 FW_LOADER/POWER_SUPPLY/HWMON/I2C/
	# BACKLIGHT_CLASS_DEVICE/INTERVAL_TREE/ACPI_VIDEO 等内核级 select
	# （I2C 与 DRM 形成 Kconfig 递归依赖）；另移除 FB_IO_HELPERS/
	# SND_HDA_COMPONENT —— 本树未开 DRM_FBDEV_EMULATION，且内核侧符号由
	# 官方内核提供。
	help
	  Choose this option if you have an ATI Radeon graphics card.  There
	  are both PCI and AGP versions.  You don't need to choose this to
	  run the Radeon in plain VGA mode.

	  If M is selected, the module will be called radeon.

config DRM_RADEON_USERPTR
	bool "Always enable userptr support"
	depends on DRM_RADEON
	select MMU_NOTIFIER
	help
	  This option selects CONFIG_MMU_NOTIFIER if it isn't already
	  selected to enabled full userptr support.
